const questionPairs = [
  [
    "What's the fastest thing you've ever done without thinking?",
    "What's the slowest thing you've ever done on purpose?",
  ],
  [
    "What's the first thing you'd do if you woke up as a celebrity for a day?",
    "What's the first thing you'd do if you woke up as a clown for a day?",
  ],
  [
    "What's the most chaotic thing you've ever done for fun?",
    "What's the most boring thing you've ever done for fun?",
  ],
  [
    "What item would you never leave the house without?",
    "What item would you leave at home on purpose if you were trying to be dramatic?",
  ],
  [
    "What's the fastest chore you can do?",
    "What's the slowest chore you can do?",
  ],
  [
    "What's your dream lazy Sunday?",
    "What's your nightmare lazy Sunday?",
  ],
  [
    "What would make you instantly become the life of the party?",
    "What would make you instantly become the reason the party ended?",
  ],
  [
    "What's the most useful app on your phone?",
    "What's the most distracting app on your phone?",
  ],
  [
    "What is the best thing to do when you're bored at 2am?",
    "What is the worst thing to do when you're bored at 2am?",
  ],
  [
    "What's the best kind of pizza topping?",
    "What's the worst kind of pizza topping ever invented?",
  ],
  [
    "What is the funniest thing you can do in public without being asked to leave?",
    "What is the funniest thing you can do in public that would definitely get you asked to leave?",
  ],
  [
    "What's your ideal road trip snack?",
    "What's the snack that would ruin a road trip instantly?",
  ],
  [
    "If you had to be in a movie, what role would you want?",
    "If you had to be in a movie, what role would you run away from?",
  ],
  [
    "What's the best way to spend a day with friends?",
    "What's the worst way to spend a day with friends?",
  ],
  [
    "What is the most impressive thing you can do in under 10 seconds?",
    "What is the most useless thing you can do in under 10 seconds?",
  ],
  [
    "What would you do if you found money on the floor?",
    "What would you do if you got money as gift?",
  ],
  [
    "What's the most fun thing to do at a birthday party?",
    "What's the most awkward thing to do at a birthday party?",
  ],
  [
    "What is your go-to excuse to leave a conversation early?",
    "What is the worst excuse to leave a conversation early?",
  ],
  [
    "What's the most believable lie you could tell in 10 seconds?",
    "What's the least believable thing you could say in 10 seconds?",
  ],
  [
    "What is the best thing to do in a group chat?",
    "What is the most annoying thing to do in a group chat?",
  ],
  [
    "What's the funniest prank you could pull on a friend?",
    "What's the funniest prank you should never pull on a friend?",
  ],
  [
    "What's the best thing to do when you're stuck in a queue?",
    "What's the worst thing to do when you're stuck in a queue?",
  ],
  [
    "What would you do if the whole group had to eat one weird food?",
    "What would you do if the whole group had to eat one food that looked cursed?",
  ],
  [
    "What's the most dramatic way to fake being sick?",
    "What's the least dramatic way to fake being sick?",
  ],
  [
    "What is the best thing to do on a train journey?",
    "What is the worst thing to do on a train journey?",
  ],
  [
    "What's the funniest thing you could accidentally say in front of your crush?",
    "What's the funniest thing you could accidentally say in front of your boss?",
  ],
  [
    "What's the best thing to do when no one else is in the room?",
    "What's the weirdest thing to do when no one else is in the room?",
  ],
];

const state = {
  players: [],
  timerSeconds: 0,
  imposter: "",
  currentQuestionIndex: 0,
  answers: {},
  votes: {},
  questionPair: [],
  questionOrder: [0, 1],
  timerId: null,
  usedQuestions: [],
};

const setupScreen = document.getElementById("setup-screen");
const answerScreen = document.getElementById("answer-screen");
const revealScreen = document.getElementById("reveal-screen");
const voteScreen = document.getElementById("vote-screen");
const resultsScreen = document.getElementById("results-screen");

const timerValueInput = document.getElementById("timer-value");
const timerUnitSelect = document.getElementById("timer-unit");
const playerNameInput = document.getElementById("player-name");
const playerList = document.getElementById("player-list");
const secretImposter = document.getElementById("secret-imposter");
const currentPlayerName = document.getElementById("current-player-name");
const currentQuestion = document.getElementById("current-question");
const answerInput = document.getElementById("answer-input");
const answerTimer = document.getElementById("answer-timer");
const answersList = document.getElementById("answers-list");
const voteForm = document.getElementById("vote-form");
const resultsList = document.getElementById("results-list");

function renderPlayers() {
  playerList.innerHTML = "";

  state.players.forEach((player) => {
    const item = document.createElement("li");
    item.textContent = player;
    playerList.appendChild(item);
  });
}

function addPlayer() {
  const name = playerNameInput.value.trim();

  if (!name) {
    alert("Please enter a player name.");
    return;
  }

  if (state.players.includes(name)) {
    alert("That player name already exists.");
    return;
  }

  state.players.push(name);
  playerNameInput.value = "";
  renderPlayers();
}

function parseTimer() {
  const value = Number(timerValueInput.value);
  const unit = timerUnitSelect.value;

  if (!value || value <= 0) {
    alert("Please enter a valid timer value.");
    return null;
  }

  return unit === "minutes" ? value * 60 : value;
}

function getQuestionForPlayer(playerName) {
  const imposterQuestionIndex = state.questionOrder[0];
  const regularQuestionIndex = state.questionOrder[1];

  if (playerName === state.imposter) {
    return state.questionPair[imposterQuestionIndex];
  }

  return state.questionPair[regularQuestionIndex];
}

function startTimer(seconds) {
  clearInterval(state.timerId);

  let remaining = seconds;
  answerTimer.textContent = `${remaining}s`;

  state.timerId = setInterval(() => {
    remaining -= 1;

    if (remaining <= 0) {
      clearInterval(state.timerId);
      answerTimer.textContent = "0s";
      submitAnswer(true);
      return;
    }

    answerTimer.textContent = `${remaining}s`;
  }, 1000);
}

function submitAnswer(forceTimeout = false) {
  const currentPlayer = state.players[state.currentQuestionIndex];
  const answerValue = forceTimeout ? "TIME UP" : answerInput.value.trim() || "TIME UP";

  state.answers[currentPlayer] = answerValue;

  state.currentQuestionIndex += 1;

  if (state.currentQuestionIndex < state.players.length) {
    renderCurrentPlayer();
    return;
  }

  clearInterval(state.timerId);
  showRevealScreen();
}

function renderCurrentPlayer() {
  const playerName = state.players[state.currentQuestionIndex];
  const question = getQuestionForPlayer(playerName);

  currentPlayerName.textContent = playerName;
  currentQuestion.textContent = question;
  answerInput.value = "";
  startTimer(state.timerSeconds);
}

function getRandomQuestionPair() {
  let availableQuestions = questionPairs.filter((pair) => !state.usedQuestions.includes(pair[0]));

  if (availableQuestions.length === 0) {
    availableQuestions = [...questionPairs];
    state.usedQuestions = [];
  }

  const chosenPair = availableQuestions[Math.floor(Math.random() * availableQuestions.length)];
  state.usedQuestions.push(chosenPair[0]);
  return chosenPair;
}

function startGame() {
  if (state.players.length < 2) {
    alert("Please add at least 2 players.");
    return;
  }

  const timerSeconds = parseTimer();
  if (timerSeconds === null) {
    return;
  }

  state.timerSeconds = timerSeconds;
  state.imposter = state.players[Math.floor(Math.random() * state.players.length)];
  state.questionPair = getRandomQuestionPair();
  state.questionOrder = Math.random() < 0.5 ? [0, 1] : [1, 0];
  state.currentQuestionIndex = 0;
  state.answers = {};
  state.votes = {};

  secretImposter.textContent = state.imposter;
  setupScreen.classList.add("hidden");
  answerScreen.classList.remove("hidden");
  renderCurrentPlayer();
}

function showRevealScreen() {
  answerScreen.classList.add("hidden");
  revealScreen.classList.remove("hidden");

  answersList.innerHTML = "";

  state.players.forEach((player) => {
    const card = document.createElement("div");
    card.className = "answer-card";
    card.innerHTML = `
      <h4>${player}</h4>
      <p>${state.answers[player] || "TIME UP"}</p>
    `;
    answersList.appendChild(card);
  });
}

function showVoteScreen() {
  revealScreen.classList.add("hidden");
  voteScreen.classList.remove("hidden");

  voteForm.innerHTML = "";

  state.players.forEach((player) => {
    const item = document.createElement("div");
    item.className = "vote-item";

    const label = document.createElement("label");
    label.textContent = `${player} votes for:`;

    const select = document.createElement("select");
    select.name = player;

    state.players.forEach((option) => {
      const optionEl = document.createElement("option");
      optionEl.value = option;
      optionEl.textContent = option;
      select.appendChild(optionEl);
    });

    label.appendChild(select);
    item.appendChild(label);
    voteForm.appendChild(item);
  });
}

function submitVotes() {
  const selects = [...document.querySelectorAll("#vote-form select")];

  selects.forEach((select) => {
    state.votes[select.name] = select.value;
  });

  showResults();
}

function showResults() {
  voteScreen.classList.add("hidden");
  resultsScreen.classList.remove("hidden");

  resultsList.innerHTML = "";

  state.players.forEach((player) => {
    const guessedPlayer = state.votes[player];
    const guessedCorrectly = guessedPlayer === state.imposter;
    const card = document.createElement("div");
    card.className = `result-card ${guessedCorrectly ? "correct" : "wrong"}`;
    card.innerHTML = `
      <h4>${player}</h4>
      <p>${guessedCorrectly ? "Correct guess" : `Guessed ${guessedPlayer}`}</p>
    `;
    resultsList.appendChild(card);
  });

  const correctPlayers = state.players.filter((player) => state.votes[player] === state.imposter);
  const resultSummary = document.createElement("p");
  resultSummary.style.marginTop = "18px";
  resultSummary.textContent = correctPlayers.length
    ? `Correct guesses: ${correctPlayers.join(", ")}`
    : "No one guessed the imposter correctly.";
  resultsList.appendChild(resultSummary);
}

function resetGame() {
  clearInterval(state.timerId);
  state.answers = {};
  state.votes = {};
  state.imposter = "";
  state.currentQuestionIndex = 0;
  state.questionPair = [];
  playerNameInput.value = "";
  timerValueInput.value = "";
  timerUnitSelect.value = "seconds";

  resultsScreen.classList.add("hidden");
  setupScreen.classList.remove("hidden");
}

function nextRound() {
  clearInterval(state.timerId);
  state.currentQuestionIndex = 0;
  state.answers = {};
  state.votes = {};
  state.imposter = state.players[Math.floor(Math.random() * state.players.length)];
  state.questionPair = getRandomQuestionPair();
  state.questionOrder = Math.random() < 0.5 ? [0, 1] : [1, 0];

  secretImposter.textContent = state.imposter;
  resultsScreen.classList.add("hidden");
  answerScreen.classList.remove("hidden");
  renderCurrentPlayer();
}

document.getElementById("add-player-btn").addEventListener("click", addPlayer);
document.getElementById("start-game-btn").addEventListener("click", startGame);
document.getElementById("submit-answer-btn").addEventListener("click", () => submitAnswer(false));
document.getElementById("start-voting-btn").addEventListener("click", showVoteScreen);
document.getElementById("submit-votes-btn").addEventListener("click", submitVotes);
document.getElementById("new-round-btn").addEventListener("click", nextRound);
playerNameInput.addEventListener("keydown", (event) => {
  if (event.key === "Enter") {
    addPlayer();
  }
});

renderPlayers();
